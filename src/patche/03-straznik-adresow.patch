+# ═══════════════════════════════════════════════════════════════════════
+#  [kancelaria-lex] PATCH 03 — strażnik adresów modeli (warstwa B izolacji)
+# ═══════════════════════════════════════════════════════════════════════
+#
+# Kontekst (docs/05-izolacja-i-siec.md, ADR-0003):
+#
+#   U-1  Ollama jedzie przez OpenAIProvider, a kod SAM podstawia atrapę
+#        klucza "ollama" (linia ~257 tego pliku). Teza "bez klucza ścieżka
+#        jest niedostępna" jest fałszywa — kontrolować trzeba ADRES.
+#
+#   U-2  api_key i base_url mogą pochodzić z BAZY (PipelineSettings),
+#        z regułą "baza wygrywa nad zmienną środowiskową". Czysty .env
+#        niczego nie gwarantuje.
+#
+# Dlatego twarde zatrzymanie zamiast ostrzeżenia w logu: system, który
+# przy błędnej konfiguracji działa dalej i loguje ostrzeżenie, będzie
+# działał dalej — ostrzeżeń nikt nie czyta.
+
+LEX_DOSTAWCY_DOZWOLENI = frozenset({"openai", "ollama"})
+
+
+class LexBlednyAdresModelu(RuntimeError):
+    """Adres modelu spoza allowlisty. Zatrzymuje żądanie."""
+
+
+def _lex_allowlista() -> tuple[str, ...]:
+    import os
+
+    surowe = os.environ.get(
+        "LEX_DOZWOLONE_BASE_URL",
+        "http://ollama:11434/v1,http://embedder:8000",
+    )
+    return tuple(a.strip() for a in surowe.split(",") if a.strip())
+
+
+def _waliduj_base_url_lex(base_url: str | None, provider_key: str) -> None:
+    """Podnosi wyjątek, gdy adres nie należy do allowlisty.
+
+    Porównanie po (schemat, host, port) — nie po całym ciągu — żeby
+    końcowy ukośnik albo dopisana ścieżka nie omijały kontroli.
+    """
+    from urllib.parse import urlparse
+
+    if provider_key not in LEX_DOSTAWCY_DOZWOLENI:
+        raise LexBlednyAdresModelu(
+            f"Dostawca {provider_key!r} jest niedozwolony w tej instalacji. "
+            f"Dopuszczalni: {sorted(LEX_DOSTAWCY_DOZWOLENI)}. "
+            f"Patrz docs/05-izolacja-i-siec.md."
+        )
+
+    if base_url is None:
+        return
+
+    def klucz(u: str):
+        p = urlparse(u)
+        return (p.scheme, p.hostname, p.port)
+
+    dozwolone = _lex_allowlista()
+    if klucz(base_url) not in {klucz(a) for a in dozwolone}:
+        raise LexBlednyAdresModelu(
+            f"Adres modelu {base_url!r} jest spoza allowlisty. "
+            f"Dozwolone: {list(dozwolone)}. "
+            f"Zgłoszenie zostało odrzucone — treść akt nie opuści instalacji. "
+            f"Patrz ADR-0003."
+        )
+
+
 def _construct_model(
