# kancelaria-lex — konfiguracja przykładowa
#
# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
#
# ⚠️ ŚWIADOMIE NIE MA TU ŻADNYCH KLUCZY DOSTAWCÓW CHMUROWYCH.
#    Ale uwaga: sam brak kluczy NIE jest zabezpieczeniem (ustalenie U-1).
#    Kod upstreamu podstawia atrapę klucza "ollama", gdy klucza brak,
#    a poświadczenia mogą mieszkać w BAZIE DANYCH z regułą
#    "baza wygrywa nad zmienną środowiskową" (U-2).
#
#    Zabezpieczeniem jest ADRES + brak trasy sieciowej — trzy warstwy
#    opisane w docs/05-izolacja-i-siec.md.

# ── Warstwa B izolacji: allowlista adresów ───────────────────────
# Strażnik startowy odrzuca wszystko spoza tej listy i NIE POZWALA
# procesowi wstać. Ta sama lista blokuje zapis do PipelineSettings.
LEX_DOZWOLONE_BASE_URL=http://ollama:11434/v1,http://embedder:8000

LEX_LLM_BASE_URL=http://ollama:11434/v1
LEX_LLM_MODEL=bielik-lex-dev
LEX_EMBEDDER_URL=http://embedder:8000

# ── Telemetria ───────────────────────────────────────────────────
# Pakiet posthog jest USUNIĘTY z builda (warstwa A). Poniższe to
# zabezpieczenie na wypadek, gdyby wrócił przy merge'u z upstreamem.
TELEMETRY_ENABLED=False
REACT_APP_POSTHOG_API_KEY=

# ── Baza danych ──────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kancelaria_lex
POSTGRES_USER=lex
POSTGRES_PASSWORD=          # UZUPEŁNIĆ — silne, losowe

# ── Magazyn obiektów ─────────────────────────────────────────────
MINIO_ROOT_USER=lex
MINIO_ROOT_PASSWORD=        # UZUPEŁNIĆ — silne, losowe

# ── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=          # UZUPEŁNIĆ — losowe, min. 50 znaków
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kancelaria-lex.local,localhost

# ── OCR ──────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
OCR_LANG=pol
OCR_FALLBACK=rapidocr

# ── Domena i TLS ─────────────────────────────────────────────────
# BEZ ACME (ustalenie U-6) — certyfikaty z infra/ca/utworz-ca.sh
LEX_DOMENA=kancelaria-lex.local

# ── Poufność ─────────────────────────────────────────────────────
# Klucz materiału obrończego NIE MOŻE być tutaj.
# Tajemnica obrończa (art. 178 pkt 1 k.p.k.) nie podlega uchyleniu —
# klucz przechowywany rozdzielnie, na nośniku sprzętowym, z autoryzacją
# dwuosobową. Patrz docs/09-compliance/tajemnica-zawodowa.md (T-2).
LEX_MAGAZYN_OBRONCZY_ENDPOINT=
